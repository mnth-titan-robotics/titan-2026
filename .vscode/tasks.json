{
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": {
        "executable": "powershell",
        "args": [".venv\\Scripts\\activate.ps1", ";"]
      }
    }
  },
  "linux": {
    "options": {
      "shell": {
        "executable": "bash",
        "args": [ "--init-file", ".venv/bin/activate", "-ci" ]
      }
    },
  },
  "tasks": [
    {
      "label": "RobotPy Project: Install Prerequisites",
      "type": "shell",
      "args": ["./.vscode/scripts/install.py"],
      "command": "${command:python.interpreterPath}",
      "problemMatcher": []
    },
    {
      "label": "RobotPy Project: Install/Update Libraries",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "robotpy", "sync", "--use-certifi"],
      "problemMatcher": []
    },
    {
      "label": "RobotPy Project: Test Robot Code",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "robotpy", "test", "--isolated", "--", "-v", "-s", "--exitfirst"],
      "problemMatcher": []
    },
    {
      "label": "RobotPy Project: Simulate Robot Code",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "robotpy", "sim"],
      "problemMatcher": []
    },
    {
      "label": "RobotPy Project: Deploy Robot Code",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "robotpy", "deploy", "--skip-tests", "--ignore-image-version"],
      "problemMatcher": []
    }
  ]
}